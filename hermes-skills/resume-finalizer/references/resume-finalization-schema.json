{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResumeFinalization",
  "type": "object",
  "required": [
    "application_id",
    "final_version",
    "review",
    "source_paths",
    "output_paths",
    "hashes",
    "release_gates",
    "finalized_at",
    "manifest_status",
    "next_permitted_workflows"
  ],
  "properties": {
    "application_id": {
      "type": "string"
    },
    "final_version": {
      "type": "integer",
      "minimum": 1
    },
    "review": {
      "type": "object",
      "required": [
        "score",
        "verdict",
        "critical_count",
        "high_count"
      ],
      "properties": {
        "score": {
          "type": "integer",
          "minimum": 90,
          "maximum": 100
        },
        "verdict": {
          "const": "ready"
        },
        "critical_count": {
          "const": 0
        },
        "high_count": {
          "const": 0
        }
      },
      "additionalProperties": false
    },
    "source_paths": {
      "type": "object",
      "required": [
        "resume",
        "trace",
        "review",
        "plan"
      ],
      "properties": {
        "resume": {
          "type": "string"
        },
        "trace": {
          "type": "string"
        },
        "review": {
          "type": "string"
        },
        "plan": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "output_paths": {
      "type": "object",
      "required": [
        "final_resume",
        "snapshot_resume",
        "snapshot_trace",
        "snapshot_review",
        "finalization_markdown"
      ],
      "properties": {
        "final_resume": {
          "type": "string"
        },
        "snapshot_resume": {
          "type": "string"
        },
        "snapshot_trace": {
          "type": "string"
        },
        "snapshot_review": {
          "type": "string"
        },
        "finalization_markdown": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "hashes": {
      "type": "object",
      "required": [
        "source_resume_sha256",
        "final_resume_sha256",
        "snapshot_resume_sha256",
        "source_trace_sha256",
        "snapshot_trace_sha256",
        "source_review_sha256",
        "snapshot_review_sha256",
        "plan_sha256"
      ],
      "properties": {
        "source_resume_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "final_resume_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "snapshot_resume_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_trace_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "snapshot_trace_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_review_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "snapshot_review_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "plan_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "release_gates": {
      "type": "object",
      "required": [
        "manifest_was_review",
        "review_ready",
        "score_at_least_90",
        "no_critical_findings",
        "no_high_findings",
        "draft_validation_passed",
        "review_validation_passed",
        "no_unresolved_revision_conflicts",
        "content_hashes_match"
      ],
      "properties": {
        "manifest_was_review": {
          "const": true
        },
        "review_ready": {
          "const": true
        },
        "score_at_least_90": {
          "const": true
        },
        "no_critical_findings": {
          "const": true
        },
        "no_high_findings": {
          "const": true
        },
        "draft_validation_passed": {
          "const": true
        },
        "review_validation_passed": {
          "const": true
        },
        "no_unresolved_revision_conflicts": {
          "const": true
        },
        "content_hashes_match": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "finalized_at": {
      "type": "string"
    },
    "manifest_status": {
      "const": "ready"
    },
    "next_permitted_workflows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "resume-pdf-renderer",
          "cover-letter-planner",
          "application-answer-planner",
          "interview-planner"
        ]
      }
    }
  },
  "additionalProperties": false
}