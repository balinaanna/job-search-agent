{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResumePdfRelease",
  "type": "object",
  "required": [
    "application_id",
    "final_version",
    "source",
    "outputs",
    "hashes",
    "pdf",
    "layout",
    "validation",
    "manifest_status",
    "next_permitted_workflows"
  ],
  "properties": {
    "application_id": {
      "type": "string"
    },
    "final_version": {
      "type": "integer",
      "minimum": 1
    },
    "source": {
      "type": "object",
      "required": [
        "markdown_path",
        "finalization_path"
      ],
      "properties": {
        "markdown_path": {
          "type": "string"
        },
        "finalization_path": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "outputs": {
      "type": "object",
      "required": [
        "pdf_path",
        "snapshot_pdf_path",
        "release_markdown_path"
      ],
      "properties": {
        "pdf_path": {
          "type": "string"
        },
        "snapshot_pdf_path": {
          "type": "string"
        },
        "release_markdown_path": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "hashes": {
      "type": "object",
      "required": [
        "source_markdown_sha256",
        "pdf_sha256",
        "snapshot_pdf_sha256"
      ],
      "properties": {
        "source_markdown_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "pdf_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "snapshot_pdf_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "pdf": {
      "type": "object",
      "required": [
        "page_count",
        "page_size",
        "renderer"
      ],
      "properties": {
        "page_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "page_size": {
          "const": "LETTER"
        },
        "renderer": {
          "const": "reportlab"
        }
      },
      "additionalProperties": false
    },
    "layout": {
      "type": "object",
      "required": [
        "font_family",
        "name_font_size",
        "contact_font_size",
        "heading_font_size",
        "body_font_size",
        "left_margin_inches",
        "right_margin_inches",
        "top_margin_inches",
        "bottom_margin_inches",
        "single_column"
      ],
      "properties": {
        "font_family": {
          "const": "Helvetica"
        },
        "name_font_size": {
          "type": "number",
          "minimum": 12,
          "maximum": 18
        },
        "contact_font_size": {
          "type": "number",
          "minimum": 8,
          "maximum": 10
        },
        "heading_font_size": {
          "type": "number",
          "minimum": 9,
          "maximum": 12
        },
        "body_font_size": {
          "type": "number",
          "minimum": 8.5,
          "maximum": 10
        },
        "left_margin_inches": {
          "type": "number",
          "minimum": 0.4,
          "maximum": 0.8
        },
        "right_margin_inches": {
          "type": "number",
          "minimum": 0.4,
          "maximum": 0.8
        },
        "top_margin_inches": {
          "type": "number",
          "minimum": 0.4,
          "maximum": 0.8
        },
        "bottom_margin_inches": {
          "type": "number",
          "minimum": 0.4,
          "maximum": 0.8
        },
        "single_column": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "validation": {
      "type": "object",
      "required": [
        "finalization_valid",
        "source_hash_matches_finalization",
        "pdf_snapshot_matches",
        "text_fidelity_passed",
        "visual_inspection_passed",
        "no_clipping",
        "no_overlaps",
        "no_broken_glyphs"
      ],
      "properties": {
        "finalization_valid": {
          "const": true
        },
        "source_hash_matches_finalization": {
          "const": true
        },
        "pdf_snapshot_matches": {
          "const": true
        },
        "text_fidelity_passed": {
          "const": true
        },
        "visual_inspection_passed": {
          "type": "boolean"
        },
        "no_clipping": {
          "type": "boolean"
        },
        "no_overlaps": {
          "type": "boolean"
        },
        "no_broken_glyphs": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "manifest_status": {
      "const": "rendered"
    },
    "next_permitted_workflows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "cover-letter-planner",
          "application-answer-planner",
          "application-package-validator",
          "interview-planner"
        ]
      }
    }
  },
  "additionalProperties": false
}