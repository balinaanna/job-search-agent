{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CoverLetterPlan",
  "type": "object",
  "required": [
    "application_id",
    "recommendation",
    "strategic_role",
    "core_message",
    "employer_motivation",
    "structure",
    "paragraphs",
    "keyword_plan",
    "repetition_controls",
    "risk_controls",
    "writing_controls",
    "writer_handoff",
    "manifest_status"
  ],
  "properties": {
    "application_id": {
      "type": "string"
    },
    "recommendation": {
      "enum": [
        "write",
        "optional",
        "skip"
      ]
    },
    "strategic_role": {
      "type": "object",
      "required": [
        "adds_beyond_resume",
        "risk_addressed",
        "rationale"
      ],
      "properties": {
        "adds_beyond_resume": {
          "type": "string",
          "minLength": 1
        },
        "risk_addressed": {
          "type": "string"
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "core_message": {
      "type": "object",
      "required": [
        "thesis",
        "value_proposition",
        "opening_strategy",
        "closing_strategy"
      ],
      "properties": {
        "thesis": {
          "type": "string",
          "minLength": 1
        },
        "value_proposition": {
          "type": "string",
          "minLength": 1
        },
        "opening_strategy": {
          "type": "string",
          "minLength": 1
        },
        "closing_strategy": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "employer_motivation": {
      "type": "object",
      "required": [
        "angle",
        "source_ids",
        "personalization_limit"
      ],
      "properties": {
        "angle": {
          "type": "string"
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "personalization_limit": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "structure": {
      "type": "object",
      "required": [
        "paragraph_count",
        "target_words_min",
        "target_words_max"
      ],
      "properties": {
        "paragraph_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "target_words_min": {
          "type": "integer",
          "minimum": 100,
          "maximum": 500
        },
        "target_words_max": {
          "type": "integer",
          "minimum": 120,
          "maximum": 600
        }
      },
      "additionalProperties": false
    },
    "paragraphs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "paragraph_id",
          "purpose",
          "planned_claim",
          "evidence_ids",
          "resume_element_ids",
          "keywords",
          "must_not_repeat",
          "prohibited_exaggerations"
        ],
        "properties": {
          "paragraph_id": {
            "type": "string",
            "pattern": "^clp_[0-9]+$"
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "planned_claim": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "resume_element_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "must_not_repeat": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "prohibited_exaggerations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "keyword_plan": {
      "type": "object",
      "required": [
        "priority_keywords",
        "natural_use_only",
        "excluded_keywords"
      ],
      "properties": {
        "priority_keywords": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "natural_use_only": {
          "const": true
        },
        "excluded_keywords": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "repetition_controls": {
      "type": "object",
      "required": [
        "resume_content_not_to_duplicate",
        "allowed_reinforcement"
      ],
      "properties": {
        "resume_content_not_to_duplicate": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowed_reinforcement": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "risk_controls": {
      "type": "object",
      "required": [
        "forbidden_claims",
        "unsupported_employer_claims",
        "transition_risks"
      ],
      "properties": {
        "forbidden_claims": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unsupported_employer_claims": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "transition_risks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "writing_controls": {
      "type": "object",
      "required": [
        "tone",
        "sentence_style",
        "first_person",
        "forbidden_phrases",
        "formatting_rules"
      ],
      "properties": {
        "tone": {
          "type": "string",
          "minLength": 1
        },
        "sentence_style": {
          "type": "string",
          "minLength": 1
        },
        "first_person": {
          "type": "string",
          "minLength": 1
        },
        "forbidden_phrases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "formatting_rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "writer_handoff": {
      "type": "object",
      "required": [
        "paragraph_order",
        "required_claims",
        "evidence_boundaries",
        "required_keywords",
        "prohibited_content",
        "completion_rule"
      ],
      "properties": {
        "paragraph_order": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^clp_[0-9]+$"
          },
          "uniqueItems": true
        },
        "required_claims": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_boundaries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required_keywords": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "prohibited_content": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "completion_rule": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "manifest_status": {
      "const": "cover_letter_planning"
    }
  },
  "additionalProperties": false
}