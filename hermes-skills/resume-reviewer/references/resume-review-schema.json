{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResumeReview",
  "type": "object",
  "required": [
    "application_id",
    "resume_path",
    "source_plan_path",
    "source_strategy_path",
    "review_score",
    "verdict",
    "first_impression",
    "strengths",
    "strategic_coverage",
    "keyword_coverage",
    "findings",
    "revision_brief",
    "strengths_to_preserve",
    "validation_summary"
  ],
  "properties": {
    "application_id": {
      "type": "string"
    },
    "resume_path": {
      "type": "string"
    },
    "source_plan_path": {
      "type": "string"
    },
    "source_strategy_path": {
      "type": "string"
    },
    "review_score": {
      "type": "object",
      "required": [
        "first_scan_clarity",
        "strategic_alignment",
        "evidence_accomplishments",
        "relevance_keyword_coverage",
        "readability_structure",
        "credibility_defensibility",
        "total"
      ],
      "properties": {
        "first_scan_clarity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "strategic_alignment": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "evidence_accomplishments": {
          "type": "integer",
          "minimum": 0,
          "maximum": 25
        },
        "relevance_keyword_coverage": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "readability_structure": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "credibility_defensibility": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      },
      "additionalProperties": false
    },
    "verdict": {
      "enum": [
        "ready",
        "minor_revision",
        "major_revision",
        "rewrite_required"
      ]
    },
    "first_impression": {
      "type": "string"
    },
    "strengths": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      }
    },
    "strategic_coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "requirement",
          "status",
          "evidence",
          "comment"
        ],
        "properties": {
          "requirement": {
            "type": "string"
          },
          "status": {
            "enum": [
              "strong",
              "adequate",
              "weak",
              "missing",
              "intentionally_excluded"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "comment": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "keyword_coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "term",
          "status",
          "planned_location",
          "comment"
        ],
        "properties": {
          "term": {
            "type": "string"
          },
          "status": {
            "enum": [
              "naturally_present",
              "present_but_weak",
              "absent_support_available",
              "absent_unsupported",
              "intentionally_excluded"
            ]
          },
          "planned_location": {
            "type": "string"
          },
          "comment": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "finding_id",
          "severity",
          "category",
          "location",
          "problem",
          "why_it_matters",
          "revision_instruction",
          "source_ids",
          "auto_fixable"
        ],
        "properties": {
          "finding_id": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "category": {
            "enum": [
              "first_scan",
              "strategy",
              "evidence",
              "keyword",
              "readability",
              "structure",
              "credibility",
              "grammar",
              "length",
              "repetition"
            ]
          },
          "location": {
            "type": "string"
          },
          "problem": {
            "type": "string"
          },
          "why_it_matters": {
            "type": "string"
          },
          "revision_instruction": {
            "type": "string"
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "auto_fixable": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "revision_brief": {
      "type": "object",
      "required": [
        "sections_to_revise",
        "planned_bullet_ids_to_revise",
        "planned_bullet_ids_to_remove",
        "planned_bullet_order",
        "keywords_to_integrate",
        "wording_to_soften",
        "repetition_to_consolidate",
        "must_remain_unchanged",
        "target_outcome"
      ],
      "properties": {
        "sections_to_revise": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "planned_bullet_ids_to_revise": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "planned_bullet_ids_to_remove": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "planned_bullet_order": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "keywords_to_integrate": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "wording_to_soften": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "repetition_to_consolidate": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "must_remain_unchanged": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "target_outcome": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "strengths_to_preserve": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "validation_summary": {
      "type": "object",
      "required": [
        "critical_count",
        "high_count",
        "medium_count",
        "low_count",
        "all_finding_ids_unique",
        "score_components_valid",
        "verdict_consistent"
      ],
      "properties": {
        "critical_count": {
          "type": "integer",
          "minimum": 0
        },
        "high_count": {
          "type": "integer",
          "minimum": 0
        },
        "medium_count": {
          "type": "integer",
          "minimum": 0
        },
        "low_count": {
          "type": "integer",
          "minimum": 0
        },
        "all_finding_ids_unique": {
          "type": "boolean"
        },
        "score_components_valid": {
          "type": "boolean"
        },
        "verdict_consistent": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}