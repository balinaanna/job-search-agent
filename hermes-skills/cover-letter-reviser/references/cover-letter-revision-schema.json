{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CoverLetterRevision",
  "type": "object",
  "required": [
    "application_id",
    "source_review",
    "version",
    "snapshots",
    "authorized_paragraph_ids",
    "processed_findings",
    "paragraph_changes",
    "unchanged_paragraph_ids",
    "word_counts",
    "preservation_checks",
    "validation",
    "manifest_status"
  ],
  "properties": {
    "application_id": {
      "type": "string"
    },
    "source_review": {
      "type": "object",
      "required": [
        "score",
        "verdict",
        "review_path"
      ],
      "properties": {
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "verdict": {
          "enum": [
            "minor_revision",
            "major_revision",
            "rewrite_required"
          ]
        },
        "review_path": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "snapshots": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "artifact_type",
          "path",
          "sha256"
        ],
        "properties": {
          "artifact_type": {
            "enum": [
              "cover_letter",
              "cover_letter_trace",
              "cover_letter_review_json",
              "cover_letter_review_markdown"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "authorized_paragraph_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^clp_[0-9]+$"
      },
      "uniqueItems": true
    },
    "processed_findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "finding_id",
          "paragraph_id",
          "status",
          "revision_instruction",
          "resolution_summary"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "pattern": "^clf_[0-9]+$"
          },
          "paragraph_id": {
            "type": "string",
            "pattern": "^clp_[0-9]+$"
          },
          "status": {
            "enum": [
              "resolved",
              "partially_resolved",
              "not_resolved"
            ]
          },
          "revision_instruction": {
            "type": "string",
            "minLength": 1
          },
          "resolution_summary": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "paragraph_changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "paragraph_id",
          "finding_ids",
          "before_text",
          "after_text",
          "change_summary",
          "evidence_ids_before",
          "evidence_ids_after",
          "resume_element_ids_before",
          "resume_element_ids_after",
          "word_count_before",
          "word_count_after"
        ],
        "properties": {
          "paragraph_id": {
            "type": "string",
            "pattern": "^clp_[0-9]+$"
          },
          "finding_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^clf_[0-9]+$"
            },
            "uniqueItems": true
          },
          "before_text": {
            "type": "string",
            "minLength": 1
          },
          "after_text": {
            "type": "string",
            "minLength": 1
          },
          "change_summary": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ids_before": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "evidence_ids_after": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "resume_element_ids_before": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "resume_element_ids_after": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "word_count_before": {
            "type": "integer",
            "minimum": 1
          },
          "word_count_after": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false
      }
    },
    "unchanged_paragraph_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^clp_[0-9]+$"
      },
      "uniqueItems": true
    },
    "word_counts": {
      "type": "object",
      "required": [
        "before",
        "after",
        "target_min",
        "target_max",
        "within_range"
      ],
      "properties": {
        "before": {
          "type": "integer",
          "minimum": 1
        },
        "after": {
          "type": "integer",
          "minimum": 1
        },
        "target_min": {
          "type": "integer",
          "minimum": 1
        },
        "target_max": {
          "type": "integer",
          "minimum": 1
        },
        "within_range": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "preservation_checks": {
      "type": "object",
      "required": [
        "paragraph_order_preserved",
        "paragraph_count_preserved",
        "evidence_ids_preserved",
        "resume_element_ids_preserved",
        "candidate_strategy_preserved",
        "cover_letter_plan_preserved",
        "review_strengths_preserved",
        "no_unapproved_paragraphs_changed",
        "no_new_claims_introduced",
        "no_forbidden_phrases",
        "no_verbatim_resume_duplication"
      ],
      "properties": {
        "paragraph_order_preserved": {
          "const": true
        },
        "paragraph_count_preserved": {
          "const": true
        },
        "evidence_ids_preserved": {
          "const": true
        },
        "resume_element_ids_preserved": {
          "const": true
        },
        "candidate_strategy_preserved": {
          "const": true
        },
        "cover_letter_plan_preserved": {
          "const": true
        },
        "review_strengths_preserved": {
          "const": true
        },
        "no_unapproved_paragraphs_changed": {
          "const": true
        },
        "no_new_claims_introduced": {
          "const": true
        },
        "no_forbidden_phrases": {
          "const": true
        },
        "no_verbatim_resume_duplication": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "validation": {
      "type": "object",
      "required": [
        "schema_passed",
        "snapshot_hashes_passed",
        "finding_scope_passed",
        "trace_matches_letter",
        "word_count_passed",
        "manifest_passed"
      ],
      "properties": {
        "schema_passed": {
          "const": true
        },
        "snapshot_hashes_passed": {
          "const": true
        },
        "finding_scope_passed": {
          "const": true
        },
        "trace_matches_letter": {
          "const": true
        },
        "word_count_passed": {
          "const": true
        },
        "manifest_passed": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "manifest_status": {
      "const": "cover_letter_revision"
    }
  },
  "additionalProperties": false
}